@startuml
!theme plain
skinparam backgroundColor white
skinparam handwritten false
skinparam shadow false
skinparam defaultFontName Arial
skinparam defaultFontSize 14

' Styles
skinparam rectangle {
    RoundCorner 15
    BorderThickness 2
    BackgroundColor White
}
skinparam arrow {
    Thickness 2
    Color #555555
}
skinparam database {
    BackgroundColor #F0FFF0
    BorderColor DarkGreen
}

' --- 1. SOURCES DE DONNÉES (GAUCHE) ---
actor "<b>Citoyens</b>\n(Terrain)" as citoyen #black
cloud "<b>Météo</b>\n(Open-Meteo)" as meteo #E6F2FF
database "<b>Données Géo</b>\n(Shapefiles, Zones,\nBassins)" as geodata

' --- 2. CŒUR DU SYSTÈME (CENTRE) ---
rectangle "<b>SYSTÈME INTELLIGENT INTÉGRÉ</b>" as systeme {
    
    ' PILIER VISION (ROUGE)
    rectangle "<b>DÉTECTION</b>\n(Vision par IA)" as detect #MistyRose {
        component "Modèle ResNet-18" as resnet #White
        note bottom of resnet
           Validation Image
           (Inondé vs Normal)
        end note
    }

    ' PILIER PRÉDICTION (BLEU)
    rectangle "<b>PRÉDICTION</b>\n(Analyse Météo)" as predict #LightBlue {
        component "Modèle Random Forest" as rf #White
        note bottom of rf
           Calcul du risque
           (Basé sur cumuls)
        end note
    }

    ' PILIER COLLABORATION (VERT)
    rectangle "<b>COLLABORATION</b>\n(Plateforme & Carte)" as collab #Honeydew {
        component "Carte Interactive\n(Visualisation)" as map #White
    }
}

' --- 3. UTILISATEURS (DROITE) ---
actor "<b>Autorités</b>\n(Décideurs)" as autorite #black

' --- FLUX ET RELATIONS ---

' Flux Vision
citoyen -[thickness=3,#DarkRed]-> detect : " Photo + GPS"
detect -[thickness=3,#DarkRed]-> collab : " Alerte Validée"

' Flux Météo
meteo -[thickness=3,#Blue]-> predict : " Données 2005-2025"
predict -[thickness=3,#Blue]-> collab : " Probabilité de risque"

' Flux Géo (AJOUTÉ ICI)
geodata -[thickness=3,#DarkGreen]-> collab : " Contextualisation\n(Zones Inondables)"

' Flux Décision
collab -[thickness=3]-> autorite : " Aide à la décision"

@enduml